<nav id="main-nav" class="align-center top-0 z-50 flex min-h-[88px] w-full max-w-4xl flex-row items-center justify-between gap-4 bg-linear-to-t from-white/0 from-0% to-white to-10% px-4 pt-4 pb-4 sm:pb-8 text-sm font-medium sm:sticky sm:to-25% md:px-12 xl:px-8">
  <div class="flex min-h-[40px] items-center gap-4">
    {% if layout == "layouts/case-study.njk" %}
    <!-- Case Study Back Button -->
    <button onclick="history.back()" class="before:block: before:rounded-lg before:absolute before:top-0 before:bottom-0 before:right-0 before:left-0 inline-flex gap-3 relative items-center justify-center whitespace-nowrap rounded-lg text-base font-medium ring-offset-white disabled:pointer-events-none disabled:bg-neutral-100 disabled:text-neutral-500 disabled:shadow-none active:transform active:scale-[99%] active:transition-transform active:duration-75 active:ease-in-out hover:cursor-pointer text-neutral-900 hover:before:bg-special-state-hover h-10 w-10">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left">
        <path d="m12 19-7-7 7-7"></path>
        <path d="M19 12H5"></path>
      </svg>
    </button>
    {% endif %}
    
    <div class="flex flex-col font-mono lg:flex-row lg:gap-2">
      <a class="text-secondary hover:text-primary" href="/">{{ site.author.name }}</a>
      <span class="text-secondary hidden lg:inline">—</span>
      {% if layout == "layouts/case-study.njk" %}
      <span class="text-primary">/ Case study</span>
      {% else %}      
      <div class="dropping-texts">
        <span class="text-secondary">AI Engineer</span>
        <span class="text-secondary">Application Developer</span>
        <span class="text-secondary">UX Researcher</span>
        <span class="text-secondary">Technical Lead</span>
      </div>
      {% endif %}
    </div>
  </div>
  
  <!-- Desktop nav links -->
  <div class="hidden items-center gap-1 sm:flex">
    {% for item in navigation %}
    <a class="text-secondary hover:text-primary rounded-lg p-2 transition-colors duration-200 ease-in-out {% if page.url == item.href %}text-primary{% endif %}" href="{{ item.href }}"{% if item.external %} target="_blank" rel="noopener noreferrer"{% endif %}>
      {{ item.name }}
    </a>
    {% endfor %}
  </div>
  
  <!-- Mobile burger button -->
  <button id="burger-btn" aria-label="Toggle menu" aria-expanded="false" class="sm:hidden flex h-10 w-10 items-center justify-center rounded-lg text-neutral-700 hover:bg-neutral-100 transition-colors duration-200">
    <svg id="icon-menu" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-menu">
      <line x1="4" x2="20" y1="6" y2="6"/>
      <line x1="4" x2="20" y1="12" y2="12"/>
      <line x1="4" x2="20" y1="18" y2="18"/>
    </svg>
    <svg id="icon-x" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x hidden">
      <path d="M18 6 6 18"/>
      <path d="m6 6 12 12"/>
    </svg>
  </button>
</nav>

<!-- Mobile dropdown — fixed, positioned by JS to sit just below the nav -->
<div id="mobile-menu" aria-hidden="true" style="display:none;position:fixed;top:0;left:12px;right:12px;z-index:9999;" class="sm:hidden">
  <div class="overflow-hidden rounded-2xl border border-neutral-100 bg-white shadow-xl shadow-neutral-900/10">
    <div class="flex flex-col p-2">
      {% for item in navigation %}
      <a
        class="group flex items-center justify-between rounded-xl px-4 py-3 text-sm font-medium transition-all duration-150 ease-in-out {% if page.url == item.href %}bg-neutral-100 text-neutral-900{% else %}text-neutral-500 hover:bg-neutral-50 hover:text-neutral-900{% endif %}"
        href="{{ item.href }}"
        {% if item.external %} target="_blank" rel="noopener noreferrer"{% endif %}
      >
        {{ item.name }}
        {% if item.external %}
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right opacity-40 group-hover:opacity-100 transition-opacity">
          <path d="M7 7h10v10"/><path d="M7 17 17 7"/>
        </svg>
        {% endif %}
      </a>
      {% endfor %}
    </div>
  </div>
</div>

<script>
  (function () {
    var btn = document.getElementById('burger-btn');
    var menu = document.getElementById('mobile-menu');
    var iconMenu = document.getElementById('icon-menu');
    var iconX = document.getElementById('icon-x');
    var nav = document.getElementById('main-nav');

    function positionMenu() {
      var rect = nav.getBoundingClientRect();
      menu.style.top = rect.bottom + 4 + 'px';
    }

    function openMenu() {
      positionMenu();
      menu.style.display = 'block';
      btn.setAttribute('aria-expanded', 'true');
      menu.setAttribute('aria-hidden', 'false');
      iconMenu.classList.add('hidden');
      iconX.classList.remove('hidden');
    }

    function closeMenu() {
      menu.style.display = 'none';
      btn.setAttribute('aria-expanded', 'false');
      menu.setAttribute('aria-hidden', 'true');
      iconMenu.classList.remove('hidden');
      iconX.classList.add('hidden');
    }

    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      menu.style.display === 'none' ? openMenu() : closeMenu();
    });

    document.addEventListener('click', function (e) {
      if (menu.style.display !== 'none' && !menu.contains(e.target) && !btn.contains(e.target)) {
        closeMenu();
      }
    });

    menu.querySelectorAll('a').forEach(function (link) {
      link.addEventListener('click', closeMenu);
    });

    window.addEventListener('resize', function () {
      if (menu.style.display !== 'none') positionMenu();
    });
  })();
</script>
