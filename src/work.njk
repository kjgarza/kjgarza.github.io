---
layout: layouts/base.njk
title: Work
description: Case studies by Kristian Garza on AI services, knowledge graphs, LLM query translation, design systems and research infrastructure.
permalink: /work/
---
{% from "components/ui/badge.njk" import badge %}
{% from "components/ui/button.njk" import button %}

<div class="flex w-full max-w-4xl flex-1 flex-col gap-6 p-4 md:p-12 xl:p-8">
  <h1 class="text-accent font-mono text-2xl font-bold">Work</h1>
  <section class="flex flex-col gap-4 sm:grid sm:grid-cols-2 sm:grid-rows-[480px_480px_480px_320px]">
    {% for workItem in work %}
      {% if workItem.featured %}
        <div class="bg-surface hover:border-card-hover border-card {{ workItem.gridClass }} flex flex-col overflow-hidden rounded-lg border-2">
          <div class="flex flex-col gap-2 p-6">
            <div class="flex flex-row items-center justify-between">
              <p class="font-mono">{{ workItem.company }}</p>
              <div class="flex flex-row gap-1">
                {% for tag in workItem.tags %}
                {{ badge(tag) }}
                {% endfor %}
              </div>
            </div>
            <div class="flex flex-col gap-2">
              <h2 class="text-2xl font-bold">{{ workItem.title }}</h2>
              <p class="text-secondary text-base font-medium">{{ workItem.description }}</p>
              {% if workItem.status == "published" %}
                {% call button("secondary", href=workItem.link, class="w-fit mt-2") %}Read case study{% endcall %}
              {% else %}
                <p class="text-base font-medium text-neutral-500">Case study coming soon...</p>
              {% endif %}
            </div>
          </div>
          {% if workItem.image %}
          {% set imgCls = "-right-24 min-w-xl transform rounded-t-xl transition-transform duration-300 hover:scale-102 will-change-transform" %}
          <div class="{% if workItem.imageContainer %}{{ workItem.imageContainer }}{% else %}w-full px-6{% endif %}">
            {% if loop.first %}
              {% image workItem.image, workItem.title, imgCls, "eager", "high", "576px" %}
            {% else %}
              {% image workItem.image, workItem.title, imgCls, "lazy", "", "576px" %}
            {% endif %}
          </div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </section>
</div>
