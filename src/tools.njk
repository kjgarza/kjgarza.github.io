---
layout: layouts/base.njk
title: Tools
description: Side projects and AI tools built by Kristian Garza, from a dataset discovery agent and a technology radar to small everyday web apps.
permalink: /tools/
---
{% from "components/ui/badge.njk" import badge %}
{% import "components/editorial.njk" as ed %}
{% from "components/editorial.njk" import pageHeader with context %}
{#- theme.pageStyle: "editorial" = plain rows (name as the link, type, description),
    no icons or doodle; "cards" = tilted cards with app icons. Same tools, same order. -#}
{% if theme.pageStyle == "editorial" %}
<div class="ed-page">
  {{ pageHeader("Tools", "Side projects") }}
  <section class="ed-section" data-reveal aria-label="Tools">
    <ul class="ed-list">
      {%- for tool in tools %}
      {{ ed.plainRow({ title: tool.name, titleTag: "h2", href: tool.link, newTab: true, arrow: true, meta: tool.type, text: tool.description }) }}
      {%- endfor %}
    </ul>
  </section>
</div>
{% else %}
<div class="flex w-full max-w-4xl flex-1 flex-col gap-4 p-4 md:p-12 xl:p-8">
  {{ pageHeader("Tools") }}
  <section data-reveal class="flex flex-col gap-4">
    <div class="relative grid gap-6 sm:grid-cols-2 sm:gap-2">
      <img src="{{ '/drawings/used-by.svg' | url }}" alt="Used by" width="113" height="98" class="absolute top-10 -left-32 hidden rotate-2 lg:block">
      
      {% for tool in tools %}
      <div class="bg-card border-border flex h-fit w-fit {{ tool.rotation }} flex-row gap-2 rounded-2xl border-2 p-4">
        <div class="bg-card border-border h-fit w-fit rounded-xl border p-1 inset-shadow-xs">
          <div class="bg-card flex h-fit w-fit items-center justify-center rounded-lg p-1 shadow-sm">
            <img alt="{{ tool.name }}" loading="lazy" width="44" height="44" class="rounded-md" src="{{ tool.image }}">
          </div>
        </div>
        <div class="flex w-full flex-col gap-1">
          <div class="flex flex-row items-center justify-between">
            <h2 class="text-foreground text-base font-bold">{{ tool.name }}</h2>
            {{ badge(tool.type) }}
          </div>
          <p class="text-muted-foreground text-base font-medium">{{ tool.description }}</p>
          <a href="{{ tool.link }}" target="_blank" class="text-primary text-base font-medium underline hover:no-underline">
            View on the web
          </a>
        </div>
      </div>
      {% endfor %}
    </div>
  </section>
</div>
{% endif %}
