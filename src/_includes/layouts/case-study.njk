---
layout: layouts/base.njk
---

<link rel="stylesheet" href="{{ '/assets/css/case-study.css' | url }}">

<article class="cs-article flex w-full max-w-2xl flex-1 flex-col">

  <!-- ── Case Study Header ── -->
  <header class="cs-header">
    <div class="cs-eyebrow">
      <span class="cs-company">{{ company }}</span>
      <div class="cs-tags">
        {% for tag in tags %}
        <span class="cs-tag">{{ tag }}</span>
        {% endfor %}
      </div>
    </div>
    <h1 class="cs-title">{{ title }}</h1>
    <p class="cs-description">{{ description }}</p>
  </header>

  <!-- ── Hero Image ── -->
  {% if heroImage %}
  <div class="cs-hero">
    <img alt="{{ title }}" width="640" height="400" decoding="async"
         src="{{ heroImage }}" loading="lazy">
  </div>
  {% endif %}

  {% if passwordProtected %}
  <!-- ── Password Gate ── -->
  <div class="cs-prose">
    <div class="cs-password-gate">
      <h3>This content requires a password</h3>
      <p>Some things are meant to stay private. But if you're meant to see this, just reach out.</p>
      <form>
        <label for="Password">Password</label>
        <input type="password" id="Password">
        <button type="submit">Submit</button>
      </form>
    </div>
  </div>

  {% else %}

  <!-- ── Case Study Content ── -->
  <div class="cs-prose prose font-medium">
    {{ content | safe }}
  </div>

  {% endif %}

</article>
