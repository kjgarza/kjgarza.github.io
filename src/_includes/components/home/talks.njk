{#- Renders only when src/_data/talks.js has entries. -#}
{% import "components/editorial.njk" as ed %}
{% if talks.length %}
<section class="ed-block" data-reveal aria-labelledby="talks-heading">
  {{ ed.label("On stage") }}
  {{ ed.heading("Talks", "talks-heading") }}
  <ul class="ed-list">
    {%- for talk in talks %}
    {%- set talkMeta = talk.event + (", " + talk.city if talk.city else "") + (" · " + talk.role if talk.role else "") %}
    {{ ed.datedRow({ title: talk.title, href: talk.link, serif: true, meta: talkMeta, year: talk.year }) }}
    {%- endfor %}
  </ul>
</section>
{% endif %}
