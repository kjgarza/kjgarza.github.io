{% from "components/ui/button.njk" import button %}
<nav id="main-nav" class="align-center top-0 z-50 flex min-h-[88px] w-full max-w-4xl flex-row items-center justify-between gap-4 bg-linear-to-t from-white/0 from-0% to-white to-10% px-4 pt-4 pb-4 sm:pb-8 text-sm font-medium sm:sticky sm:to-25% md:px-12 xl:px-8">
  <div class="flex min-h-[40px] items-center gap-4">
    {% if layout == "layouts/case-study.njk" %}
    <!-- Case Study Back Button -->
    {#- A real link, so a visitor who landed here from search still gets to /work/; same-site visitors go back to where they were #}
    {% call button("ghost", "icon", href="/work/", attrs='aria-label="Back" onclick="if (document.referrer.indexOf(location.origin + \'/\') === 0) { history.back(); return false; }"') %}{% icon "arrow-left" %}{% endcall %}
    {% endif %}
    
    <div class="flex flex-col font-mono lg:flex-row lg:gap-2">
      <a class="text-muted-foreground hover:text-foreground" href="/">{{ site.author.name }}</a>
      <span class="text-muted-foreground hidden lg:inline">—</span>
      {% if layout == "layouts/case-study.njk" %}
      <span class="text-foreground">/ Case study</span>
      {% else %}      
      <div class="dropping-texts">
        <span class="text-muted-foreground">AI Engineer</span>
        <span class="text-muted-foreground">Application Developer</span>
        <span class="text-muted-foreground">UX Researcher</span>
        <span class="text-muted-foreground">Technical Lead</span>
      </div>
      {% endif %}
    </div>
  </div>
  
  <!-- Desktop nav links -->
  <div class="hidden items-center gap-1 sm:flex">
    {% for item in navigation %}
    {% set active = page.url == item.href or page.url == item.href + "/" %}
    <a class="{% if active %}text-foreground{% else %}text-muted-foreground{% endif %} hover:text-foreground rounded-lg p-2 transition-colors duration-200 ease-in-out" href="{{ item.href }}"{% if active %} aria-current="page"{% endif %}{% if item.external %} target="_blank" rel="noopener noreferrer"{% endif %}>
      {{ item.name }}
    </a>
    {% endfor %}
  </div>

  <!-- Mobile burger button: opens the drawer below as a modal dialog -->
  {% call button("ghost", "icon", class="sm:hidden", attrs='id="burger-btn" type="button" aria-label="Open menu" aria-haspopup="dialog" aria-controls="mobile-menu" aria-expanded="false"') %}{% icon "list", 22 %}{% endcall %}
</nav>

<!-- Mobile menu: Basecoat drawer (shadcn Sheet) on a native <dialog>. Esc, focus trapping and
     focus return come from showModal(); Basecoat's drawer.js adds the slide-out and backdrop-click close. -->
<dialog id="mobile-menu" class="drawer sm:hidden" data-side="right" aria-labelledby="mobile-menu-title">
  <div>
    <header class="flex-row items-center justify-between">
      <h2 id="mobile-menu-title" class="font-mono">Menu</h2>
      {% call button("ghost", "icon", attrs='type="button" aria-label="Close menu" data-close-menu') %}{% icon "x", 20 %}{% endcall %}
    </header>
    <section>
      <nav aria-label="Main" class="flex flex-col gap-1 px-2 pb-4">
        {% for item in navigation %}
        {% set active = page.url == item.href or page.url == item.href + "/" %}
        <a
          class="group flex items-center justify-between rounded-lg px-3 py-3 text-base font-medium transition-colors {% if active %}bg-accent text-accent-foreground{% else %}text-muted-foreground hover:bg-accent hover:text-accent-foreground{% endif %}"
          href="{{ item.href }}"{% if active %} aria-current="page"{% endif %}
          {% if item.external %} target="_blank" rel="noopener noreferrer"{% endif %}
        >
          {{ item.name }}
          {% if item.external %}
          {% icon "arrow-up-right", 14, 'class="opacity-40 group-hover:opacity-100 transition-opacity"' %}
          {% endif %}
        </a>
        {% endfor %}
      </nav>
    </section>
  </div>
</dialog>

<script>
  (function () {
    var btn = document.getElementById('burger-btn');
    var menu = document.getElementById('mobile-menu');
    var wide = window.matchMedia('(min-width: 40rem)');

    function close() { if (menu.open) menu.close(); }

    btn.addEventListener('click', function () {
      menu.showModal();
      btn.setAttribute('aria-expanded', 'true');
    });
    menu.addEventListener('close', function () { btn.setAttribute('aria-expanded', 'false'); });
    menu.querySelector('[data-close-menu]').addEventListener('click', close);
    // External links open a new tab, so close the drawer behind them
    menu.querySelectorAll('a').forEach(function (link) { link.addEventListener('click', close); });
    // At sm+ the drawer is display:none, but a modal dialog would still make the page inert
    wide.addEventListener('change', function (e) { if (e.matches) close(); });
  })();
</script>
