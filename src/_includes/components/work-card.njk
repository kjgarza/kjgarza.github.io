{% from "components/ui/badge.njk" import badge %}
{% from "components/ui/button.njk" import button %}
<div class="bg-surface hover:border-card-hover border-card {{ work.gridClass }} flex flex-col overflow-hidden rounded-lg border-2">
  <div class="flex flex-col gap-2 p-6">
    <div class="flex flex-row items-center justify-between">
      <p class="font-mono">{{ work.company }}</p>
      <div class="flex flex-row gap-1">
        {% for tag in work.tags %}
        {{ badge(tag) }}
        {% endfor %}
      </div>
    </div>
    <div class="flex flex-col gap-2">
      <h3 class="text-2xl font-bold">{{ work.title }}</h3>
      <p class="text-secondary text-base font-medium">{{ work.description }}</p>
      
      {% if work.status == "published" %}
        {% call button("secondary", href=work.link, class="w-fit mt-2") %}Read case study{% endcall %}
      {% else %}
        <p class="text-base font-medium text-neutral-500">Case study coming soon...</p>
      {% endif %}
    </div>
  </div>
  
  {% if work.image %}
  <div class="{% if work.imageContainer %}{{ work.imageContainer }}{% else %}w-full px-6{% endif %}">
    {% image work.image, work.title, "-right-24 min-w-xl transform rounded-t-xl transition-transform duration-300 hover:scale-102 will-change-transform" %}
  </div>
  {% endif %}
</div>
