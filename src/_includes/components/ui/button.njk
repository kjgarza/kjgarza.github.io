{#- shadcn-style button: variant = primary | secondary | ghost, size = default | icon.
    Renders <a> when href is set, else <button>. Extra classes go in `class`. -#}
{%- set buttonBase = "before:block before:rounded-lg before:absolute before:inset-0 inline-flex gap-3 relative items-center justify-center whitespace-nowrap rounded-lg text-base font-medium ring-offset-white disabled:pointer-events-none disabled:bg-neutral-100 disabled:text-neutral-500 disabled:shadow-none active:scale-[99%] active:transition-transform active:duration-75 active:ease-in-out hover:cursor-pointer" -%}
{%- set buttonVariants = {
  primary: "hover:before:bg-special-state-hover-inverse bg-button-primary text-white shadow-button-primary-rest active:shadow-none",
  secondary: "hover:before:bg-special-state-hover bg-white text-neutral-900 shadow-button-secondary-rest active:shadow-none",
  ghost: "hover:before:bg-special-state-hover text-neutral-900"
} -%}
{%- set buttonSizes = { default: "h-10 px-3 min-w-9", icon: "h-10 w-10" } -%}
{%- macro button(variant="secondary", size="default", href="", class="", attrs="") -%}
{%- set cls = [buttonBase, buttonVariants[variant], buttonSizes[size], class] | join(" ") | trim -%}
{%- if href %}<a class="{{ cls }}" href="{{ href }}"{% if attrs %} {{ attrs }}{% endif %}>{{ caller() }}</a>
{%- else %}<button class="{{ cls }}"{% if attrs %} {{ attrs }}{% endif %}>{{ caller() }}</button>{% endif -%}
{%- endmacro -%}
