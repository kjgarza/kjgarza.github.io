---
layout: layouts/base.njk
appendSiteName: false
---

<link rel="stylesheet" href="{{ '/assets/css/case-study.css' | url }}">

<article class="cs-article flex w-full max-w-2xl flex-1 flex-col">

  <!-- ── Case Study Header ── -->
  <header class="cs-header">
    <div class="cs-eyebrow">
      <span class="cs-company">{{ company }}</span>
      <div class="cs-tags">
        {% for tag in tags %}
        <span class="cs-tag">{{ tag }}</span>
        {% endfor %}
      </div>
    </div>
    <h1 class="cs-title">{{ title }}</h1>
    <p class="cs-description">{{ description }}</p>
  </header>

  <!-- ── Hero Image ── -->
  {% if heroImage %}
  <div class="cs-hero">
    {% image heroImage, title, "", "eager", "high", "(max-width: 672px) 100vw, 672px", [320, 672, 1344] %}
  </div>
  {% endif %}

  {% if passwordProtected %}
  {% if publicSummary %}
  <!-- ── Public summary (indexable; the rest stays behind the gate) ── -->
  <div class="cs-public-summary cs-prose prose font-medium">
    {% for paragraph in (publicSummary | trim).split("\n\n") %}
    <p>{{ paragraph | escape }}</p>
    {% endfor %}
  </div>
  {% endif %}

  <!-- ── Password Gate ── -->
  <div class="cs-prose">
    <div class="cs-password-gate">
      <h2>This content requires a password</h2>
      <p>Some things are meant to stay private. But if you're meant to see this, just reach out.</p>
      <form>
        <label for="Password">Password</label>
        <input type="password" id="Password">
        <button type="submit">Submit</button>
      </form>
    </div>
  </div>

  {% else %}

  <!-- ── Case Study Content ── -->
  <div class="cs-prose prose font-medium">
    {{ content | safe }}
  </div>

  {% endif %}

</article>
