{#- Renders only when src/_data/awards.js has entries. -#}
{% import "components/editorial.njk" as ed %}
{% if awards.length %}
<section class="ed-block" data-reveal aria-labelledby="awards-heading">
  {{ ed.label("Recognition") }}
  {{ ed.heading("Awards &amp; affiliations", "awards-heading") }}
  <ul class="ed-list">
    {%- for award in awards %}
    {{ ed.datedRow({ title: award.title, href: award.link, arrow: true, text: award.description, year: award.year }) }}
    {%- endfor %}
  </ul>
</section>
{% endif %}
