{% from "components/ui/button.njk" import button %}
{% import "components/editorial.njk" as ed %}
<section id="contact" class="ed-block ed-block--ruled home-contact" data-reveal aria-labelledby="contact-heading">
  <div class="home-contact-body">
    {{ ed.heading("Get in touch", "contact-heading") }}
    <ul class="home-contact-links">
      <li><a href="mailto:{{ site.author.email }}">Email</a></li>
      <li><a href="{{ site.author.linkedin }}">LinkedIn</a></li>
      <li><a href="{{ site.author.github }}">GitHub</a></li>
      <li><a href="{{ site.author.figma }}">Figma</a></li>
    </ul>
  </div>
  {% if theme.ctaStyle == "button" %}
  {% call button("primary", href=site.author.booking, class="w-fit home-button") %}Book a call{% endcall %}
  {% else %}
  {{ ed.link(site.author.booking, "Book a call ↗") }}
  {% endif %}
</section>
